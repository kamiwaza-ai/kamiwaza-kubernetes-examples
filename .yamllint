---
extends: default

rules:
  document-start: disable
  truthy:
    allowed-values: ["true", "false", "yes", "no", "on", "off"]
    check-keys: false
  line-length:
    max: 160
    allow-non-breakable-inline-mappings: true
    allow-non-breakable-words: true
  comments:
    min-spaces-from-content: 1
  indentation:
    spaces: 2
  # Prettier is the formatter in this repository and it writes one space
  # inside a non-empty flow mapping. Forbidding that spelling here would make
  # the two tools contradict each other, so a flow mapping would fail one of
  # them whichever way it is written.
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
