          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod, container) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"(core-api|core-retrieval-streamer|kamiwaza-dataplane|frontend)-.*\", container!=\"\"})",
          "legendFormat": "{{pod}}/{{container}}"
