          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "**Are the application workloads up, erroring, or short of resources?**\n\n- **Replicas** compares ready with desired for the API, retrieval streamer, protocol data plane, and web interface.\n- **Errors** counts error and warning log lines, the only error signal these workloads publish, against the day before.\n- **Saturation** shows each container's use of its CPU and memory limits and CPU throttling.\n\nRequest rate and latency are not shown: the application does not publish Prometheus metrics.",
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
