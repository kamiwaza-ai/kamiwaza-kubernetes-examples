      "error-rate": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Error log rate",
          "description": "Error lines per second by workload, compared with the day before",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "sum by (app) (rate({namespace=\"$namespace\", app=~\"core-api|core-retrieval-streamer|dataplane|frontend\"} |~ \"(?i)(error|exception|traceback)\" [$__auto]))",
                        "legendFormat": "{{app}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "timeCompare": "1d"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc",
                  "hideZeros": false
                },
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": ["lastNotNull", "max"],
                  "limit": 10,
                  "sortBy": "Last *",
                  "sortDesc": true
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "bars",
                    "lineInterpolation": "smooth",
                    "lineWidth": 2,
                    "fillOpacity": 70,
                    "gradientMode": "opacity",
                    "showPoints": "never",
                    "spanNulls": true,
                    "barAlignment": 0,
                    "axisBorderShow": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "api-logs": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Core API errors and warnings",
          "description": "Application API container logs at warning level or above",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{namespace=\"$namespace\", app=\"core-api\", container=\"core\"} |~ \"(?i)(error|warning|exception|traceback|critical)\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
