{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kam-03"
  },
  "spec": {
    "title": "Kamiwaza · Application API & Web Interface",
    "description": "Are the application workloads up, erroring, or short of resources?",
    "tags": ["kamiwaza"],
    "editable": false,
    "cursorSync": "Crosshair",
    "liveNow": false,
    "preload": false,
    "links": [
      {
        "title": "Kamiwaza dashboards",
        "type": "dashboards",
        "icon": "external link",
        "tooltip": "",
        "tags": ["kamiwaza"],
        "asDropdown": true,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      }
    ],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-3h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": ["30s", "1m", "5m", "15m"],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Metrics",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "loki_datasource",
          "pluginId": "loki",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Logs",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "namespace",
          "label": "Platform namespace",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": false,
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(kamiwaza_platform_condition, namespace)",
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${datasource}"
            },
            "spec": {
              "query": "label_values(kamiwaza_platform_condition, namespace)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          }
        }
      }
    ],
    "elements": {
      "core-api": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Core API",
          "description": "Ready of desired core-api replicas",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum(kube_deployment_status_replicas_ready{namespace=\"$namespace\", deployment=~\"core-api\"}) / sum(kube_deployment_spec_replicas{namespace=\"$namespace\", deployment=~\"core-api\"})",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": ["lastNotNull"],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "unit": "percentunit",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 0.01,
                        "color": "orange"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  },
                  "decimals": 0
                },
                "overrides": []
              }
            }
          }
        }
      },
      "retrieval": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Retrieval streamer",
