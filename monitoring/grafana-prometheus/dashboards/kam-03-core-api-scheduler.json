      "restarts": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Restarts",
          "description": "Container restarts over a sliding hour",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "round(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"(core-api|core-retrieval-streamer|kamiwaza-dataplane|frontend)-.*\"}[1h])) > 0",
                        "legendFormat": "{{pod}} · {{container}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc",
                  "hideZeros": false
                },
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": ["lastNotNull", "max"],
                  "limit": 8,
                  "sortBy": "Last *",
                  "sortDesc": true
                }
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "bars",
                    "lineInterpolation": "smooth",
                    "lineWidth": 2,
                    "fillOpacity": 60,
                    "gradientMode": "opacity",
                    "showPoints": "never",
                    "spanNulls": true,
                    "axisSoftMin": 0,
                    "axisBorderShow": false,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
