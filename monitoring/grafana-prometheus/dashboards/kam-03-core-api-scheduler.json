        "h": 7
      }
    },
    {
      "type": "logs",
      "title": "Core API Logs (ERROR / WARNING)",
      "description": "Application API container logs",
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "expr": "{namespace=\"$namespace\", app=\"core-api\", container=\"core\"} |~ \"(?i)(error|warning|exception|traceback|critical)\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "maxDataPoints": 100,
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 10
      }
    }
