      "error-rate": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Error lines",
          "description": "Error-level lines per second by workload, compared with the day before",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "sum by (app) (rate({namespace=\"$namespace\", app=~\"core-api|core-retrieval-streamer|dataplane|frontend\"} |~ \"(?i)(error|exception|traceback)\" [$__auto]))",
                        "legendFormat": "{{app}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "timeCompare": "1d"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc",
                  "hideZeros": false
                },
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": ["lastNotNull", "max"],
                  "limit": 8,
                  "sortBy": "Last *",
                  "sortDesc": true
                }
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "unit": "short",
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "smooth",
                    "lineWidth": 2,
                    "fillOpacity": 10,
                    "gradientMode": "opacity",
                    "showPoints": "never",
                    "spanNulls": true,
                    "axisSoftMin": 0,
                    "axisBorderShow": false,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
