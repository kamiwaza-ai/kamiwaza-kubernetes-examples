      "api-logs": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Core API errors and warnings",
          "description": "Application API log lines at warning level or above",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{namespace=\"$namespace\", app=\"core-api\", container=\"core\"} |~ \"(?i)(error|warning|exception|traceback|critical)\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": true,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "sortOrder": "Descending",
                "dedupStrategy": "none",
                "syntaxHighlighting": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "about": {
        "kind": "Panel",
        "spec": {
          "id": 12,
