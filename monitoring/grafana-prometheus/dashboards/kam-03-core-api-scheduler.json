    {
      "type": "timeseries",
      "title": "CPU Throttling %",
      "description": "Share of CFS periods throttled per container",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum by (pod, container) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"$namespace\", pod=~\"(core-api|core-retrieval-streamer|kamiwaza-dataplane|frontend)-.*\", container!=\"\"}[5m])) / sum by (pod, container) (rate(container_cpu_cfs_periods_total{namespace=\"$namespace\", pod=~\"(core-api|core-retrieval-streamer|kamiwaza-dataplane|frontend)-.*\", container!=\"\"}[5m]))",
