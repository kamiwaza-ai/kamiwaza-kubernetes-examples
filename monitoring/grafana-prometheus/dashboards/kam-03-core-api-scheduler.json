    {
      "type": "timeseries",
      "title": "Pod Restarts (1h)",
      "description": "Container restarts per pod over the last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"(core-api|core-retrieval-streamer|kamiwaza-dataplane|frontend)-.*\"}[1h]))",
          "legendFormat": "{{pod}}/{{container}}"
        }
