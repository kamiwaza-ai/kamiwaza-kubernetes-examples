{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kam-03"
  },
  "spec": {
    "title": "Kamiwaza · Application API & Web Interface",
    "description": "The application API, retrieval streamer, protocol data plane, and web interface.",
    "tags": ["kamiwaza"],
    "editable": false,
    "cursorSync": "Crosshair",
    "liveNow": false,
    "preload": false,
    "links": [
      {
        "title": "Kamiwaza dashboards",
        "type": "dashboards",
        "icon": "external link",
        "tooltip": "",
        "tags": ["kamiwaza"],
        "asDropdown": true,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      }
    ],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-3h",
      "to": "now",
      "autoRefresh": "30s",
      "autoRefreshIntervals": ["10s", "30s", "1m", "5m", "15m", "1h"],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Metrics",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "loki_datasource",
          "pluginId": "loki",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Logs",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "namespace",
          "label": "Platform namespace",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": false,
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(kamiwaza_platform_condition, namespace)",
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${datasource}"
            },
            "spec": {
              "query": "label_values(kamiwaza_platform_condition, namespace)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          }
        }
      }
    ],
    "elements": {
      "app-capabilities": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Application capabilities",
          "description": "Capabilities served by the application workloads",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "(kamiwaza_platform_component_state{namespace=\"$namespace\", component=~\"applicationAPI|webInterface|protocolDataPlane|relationshipStore\"} == 1) * on (namespace, name, component) group_left (reason) kamiwaza_platform_component_reason{namespace=\"$namespace\"}",
                        "legendFormat": "",
                        "instant": true,
                        "range": false,
                        "format": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "filterFieldsByName",
                  "spec": {
                    "id": "filterFieldsByName",
                    "options": {
                      "include": {
                        "names": ["component", "state", "reason"]
                      }
                    }
                  }
                },
                {
                  "kind": "organize",
                  "spec": {
                    "id": "organize",
                    "options": {
                      "excludeByName": {},
                      "indexByName": {
                        "component": 0,
                        "state": 1,
                        "reason": 2
                      },
                      "renameByName": {
                        "component": "Capability",
                        "state": "State",
                        "reason": "Reason"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "footer": {
                  "show": false,
                  "reducer": ["sum"],
                  "fields": ""
                },
                "sortBy": [
                  {
                    "displayName": "Capability",
                    "desc": false
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "align": "auto",
                    "filterable": true,
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "State"
                    },
                    "properties": [
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "Ready": {
                                "color": "green",
                                "index": 0
                              },
                              "ExternalReady": {
                                "color": "green",
                                "index": 1
                              },
                              "DisabledByPlan": {
                                "color": "#8e8e8e",
                                "index": 2
                              },
                              "Progressing": {
                                "color": "orange",
                                "index": 3
                              },
                              "Blocked": {
                                "color": "red",
                                "index": 4
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "core-api": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Core API",
          "description": "Ready core-api replicas",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum(kube_deployment_status_replicas_ready{namespace=\"$namespace\", deployment=~\"core-api\"}) or vector(0)",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": ["lastNotNull"],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false,
                "percentChangeColorMode": "inverted"
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
