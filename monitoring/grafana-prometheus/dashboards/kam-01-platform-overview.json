    {
      "type": "table",
      "title": "Capabilities",
      "description": "Every platform capability with its state and the operator's stable reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(kamiwaza_platform_component_state{namespace=\"$namespace\", component=~\".+\"} == 1) * on (namespace, name, component) group_left (reason) kamiwaza_platform_component_reason{namespace=\"$namespace\"}",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["component", "state", "reason"]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "component": 0,
              "state": 1,
              "reason": 2
            },
            "renameByName": {
              "component": "Capability",
              "state": "State",
              "reason": "Reason"
            }
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Capability",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Ready": {
                        "color": "green"
                      },
                      "ExternalReady": {
                        "color": "green"
                      },
                      "DisabledByPlan": {
                        "color": "text"
                      },
                      "Progressing": {
                        "color": "orange"
                      },
                      "Blocked": {
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 16
      }
