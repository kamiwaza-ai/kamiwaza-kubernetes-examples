        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kubelet_volume_stats_used_bytes",
          "instant": true,
          "legendFormat": "",
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kubelet_volume_stats_capacity_bytes",
          "instant": true,
          "legendFormat": "",
          "format": "table"
        }
