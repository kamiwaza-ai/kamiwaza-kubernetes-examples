    {
      "type": "timeseries",
      "title": "Pod Restarts (last 1h)",
      "description": "Container restarts per pod over the last hour (top 10)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, round(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h])) > 0)",
          "legendFormat": "{{pod}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
