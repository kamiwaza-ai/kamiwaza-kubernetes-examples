      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(up{job=\"keycloak\"}) or vector(0)",
          "instant": true,
          "legendFormat": ""
