  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Prometheus",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "loki_datasource",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "label": "Loki",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Platform namespace",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kamiwaza_platform_condition, namespace)",
        "query": {
          "query": "label_values(kamiwaza_platform_condition, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "current": {},
        "multi": false,
        "includeAll": false,
        "sort": 1
      }
    ]
