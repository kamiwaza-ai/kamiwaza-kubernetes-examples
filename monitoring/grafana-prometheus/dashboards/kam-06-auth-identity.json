      "auth-log": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Authentication failures",
          "description": "401, 403, and unauthorized lines across the platform namespace",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{namespace=\"$namespace\"} != \"response body\" |~ \"(?i)( 401 | 403 |status[=: \\\"]*40[13]|unauthorized|forbidden|authentication.failed|invalid.token)\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": true,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "sortOrder": "Descending",
                "dedupStrategy": "none",
                "syntaxHighlighting": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "idp-log": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Identity provider event errors",
          "description": "Keycloak event errors (requires Keycloak event logging)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{namespace=\"$namespace\", app=\"keycloak\"} |= \"org.keycloak.events\" |= \"_ERROR\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": true,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "sortOrder": "Descending",
                "dedupStrategy": "none",
                "syntaxHighlighting": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "about": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "About this dashboard",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "**Can users sign in, are authorization decisions fast and correct, and are certificates valid?**\n\n- **Authorization** follows RED for the decision service: request rate, error ratio, and p95 latency.\n- **Certificates** lists every cert-manager certificate in the platform namespace by days left.\n- **Authentication failures** counts 401, 403, and unauthorized log lines.\n\nIdentity-provider sessions and logins are not shown: the identity provider image ships without its metrics endpoint.",
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
