{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kam-06"
  },
  "spec": {
    "title": "Kamiwaza · Auth & Identity",
    "description": "Can users sign in, are authorization decisions fast and correct, and are certificates valid?",
    "tags": ["kamiwaza"],
    "editable": false,
    "cursorSync": "Crosshair",
    "liveNow": false,
    "preload": false,
    "links": [
      {
        "title": "Kamiwaza dashboards",
        "type": "dashboards",
        "icon": "external link",
        "tooltip": "",
        "tags": ["kamiwaza"],
        "asDropdown": true,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      }
    ],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-3h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": ["30s", "1m", "5m", "15m"],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Metrics",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "loki_datasource",
          "pluginId": "loki",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Logs",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "namespace",
          "label": "Platform namespace",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": false,
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(kamiwaza_platform_condition, namespace)",
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${datasource}"
            },
            "spec": {
              "query": "label_values(kamiwaza_platform_condition, namespace)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          }
        }
      }
    ],
    "elements": {
      "identity": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Identity capability",
          "description": "The operator's state for the identityAndAccess capability",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "max by (component) ((kamiwaza_platform_component_state{namespace=\"$namespace\", component=~\"identityAndAccess\", state=\"DisabledByPlan\"} == 1) * 0 or (kamiwaza_platform_component_state{namespace=\"$namespace\", component=~\"identityAndAccess\", state=~\"Ready|ExternalReady\"} == 1) * 1 or (kamiwaza_platform_component_state{namespace=\"$namespace\", component=~\"identityAndAccess\", state=\"Progressing\"} == 1) * 2 or (kamiwaza_platform_component_state{namespace=\"$namespace\", component=~\"identityAndAccess\", state=\"Blocked\"} == 1) * 3)",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": ["lastNotNull"],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "#8e8e8e"
                      }
                    ]
                  },
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "Disabled",
                          "color": "#8e8e8e",
                          "index": 0
                        },
                        "1": {
                          "text": "Ready",
                          "color": "green",
                          "index": 1
                        },
                        "2": {
                          "text": "Progressing",
                          "color": "orange",
                          "index": 2
                        },
                        "3": {
                          "text": "Blocked",
                          "color": "red",
                          "index": 3
                        }
                      }
                    }
                  ]
                },
                "overrides": []
              }
            }
          }
        }
      },
      "idp": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Identity provider",
          "description": "Ready of desired keycloak replicas",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum(kube_deployment_status_replicas_ready{namespace=\"$namespace\", deployment=~\"keycloak\"}) / sum(kube_deployment_spec_replicas{namespace=\"$namespace\", deployment=~\"keycloak\"})",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": ["lastNotNull"],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "unit": "percentunit",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 0.01,
                        "color": "orange"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  },
                  "decimals": 0
                },
                "overrides": []
              }
            }
          }
        }
      },
      "authz": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Authorization",
          "description": "Ready of desired decision-service replicas",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum(kube_deployment_status_replicas_ready{namespace=\"$namespace\", deployment=~\"spicedb\"}) / sum(kube_deployment_spec_replicas{namespace=\"$namespace\", deployment=~\"spicedb\"})",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": ["lastNotNull"],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "unit": "percentunit",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 0.01,
                        "color": "orange"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  },
                  "decimals": 0
                },
                "overrides": []
              }
            }
          }
        }
      },
      "cert-next": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Next certificate expiry",
          "description": "Earliest cert-manager certificate expiry in the platform namespace",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "min(certmanager_certificate_expiration_timestamp_seconds{namespace=\"$namespace\"} - time())",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": ["lastNotNull"],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "unit": "s",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 1209600,
                        "color": "orange"
                      },
                      {
                        "value": 2592000,
                        "color": "green"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "auth-failures": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Auth failures (range)",
          "description": "401, 403, and unauthorized lines in the selected range",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "sum(count_over_time({namespace=\"$namespace\"} != \"response body\" |~ \"(?i)( 401 | 403 |status[=: \\\"]*40[13]|unauthorized|forbidden|authentication.failed|invalid.token)\" [$__range])) or vector(0)",
                        "legendFormat": "",
                        "queryType": "instant"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": ["lastNotNull"],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "orange"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "authz-rate": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Decision rate",
          "description": "Authorization requests per second by method",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum by (grpc_method) (rate(grpc_server_handled_total{job=\"monitoring/authorization\", namespace=\"$namespace\"}[$__rate_interval]))",
                        "legendFormat": "{{grpc_method}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc",
                  "hideZeros": false
                },
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": ["lastNotNull", "max"],
                  "limit": 8,
                  "sortBy": "Last *",
                  "sortDesc": true
                }
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "unit": "reqps",
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "smooth",
                    "lineWidth": 2,
                    "fillOpacity": 10,
                    "gradientMode": "opacity",
                    "showPoints": "never",
                    "spanNulls": true,
                    "axisSoftMin": 0,
                    "axisBorderShow": false,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "authz-errors": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Decision errors",
          "description": "Share of authorization requests that did not return OK",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum(rate(grpc_server_handled_total{job=\"monitoring/authorization\", namespace=\"$namespace\", grpc_code!=\"OK\"}[$__rate_interval])) / sum(rate(grpc_server_handled_total{job=\"monitoring/authorization\", namespace=\"$namespace\"}[$__rate_interval])) or on () vector(0)",
                        "legendFormat": "error ratio"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc",
                  "hideZeros": false
                },
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": ["lastNotNull", "max"],
                  "limit": 8,
                  "sortBy": "Last *",
                  "sortDesc": true
                }
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "unit": "percentunit",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 0.01,
                        "color": "red"
                      }
                    ]
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "smooth",
                    "lineWidth": 2,
                    "fillOpacity": 10,
                    "gradientMode": "opacity",
                    "showPoints": "never",
                    "spanNulls": true,
                    "axisSoftMin": 0,
                    "axisSoftMax": 0.05,
                    "axisBorderShow": false,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "dashed"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "authz-latency": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Decision latency p95",
          "description": "95th percentile authorization latency by method; above 50 ms slows every request",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.95, sum by (le, grpc_method) (rate(grpc_server_handling_seconds_bucket{job=\"monitoring/authorization\", namespace=\"$namespace\"}[$__rate_interval])))",
                        "legendFormat": "{{grpc_method}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc",
                  "hideZeros": false
                },
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": ["lastNotNull", "max"],
                  "limit": 8,
                  "sortBy": "Last *",
                  "sortDesc": true
                }
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "unit": "s",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 0.05,
                        "color": "red"
                      }
                    ]
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "smooth",
                    "lineWidth": 2,
                    "fillOpacity": 10,
                    "gradientMode": "opacity",
                    "showPoints": "never",
                    "spanNulls": true,
                    "axisSoftMin": 0,
                    "axisBorderShow": false,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "dashed"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "certs": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Certificates",
          "description": "Days until expiry for each cert-manager certificate in the platform namespace",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "(certmanager_certificate_expiration_timestamp_seconds{namespace=\"$namespace\"} - time()) / 86400",
                        "legendFormat": "",
                        "instant": true,
                        "range": false,
                        "format": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "filterFieldsByName",
                  "spec": {
                    "id": "filterFieldsByName",
                    "options": {
                      "include": {
                        "names": ["name", "issuer_name", "Value"]
                      }
                    }
                  }
                },
                {
                  "kind": "organize",
                  "spec": {
                    "id": "organize",
                    "options": {
                      "excludeByName": {},
                      "indexByName": {
                        "name": 0,
                        "issuer_name": 1,
                        "Value": 2
                      },
                      "renameByName": {
                        "name": "Certificate",
                        "issuer_name": "Issuer",
                        "Value": "Days left"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "footer": {
                  "show": false,
                  "reducer": ["sum"],
                  "fields": ""
                },
                "sortBy": [
                  {
                    "displayName": "Days left",
                    "desc": false
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "align": "auto",
                    "filterable": true,
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Days left"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "d"
                      },
                      {
                        "id": "decimals",
                        "value": 0
                      },
                      {
                        "id": "min",
                        "value": 0
                      },
                      {
                        "id": "max",
                        "value": 400
                      },
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "value": null,
                              "color": "red"
                            },
                            {
                              "value": 14,
                              "color": "orange"
                            },
                            {
                              "value": 30,
                              "color": "green"
                            }
                          ]
                        }
                      },
                      {
                        "id": "color",
                        "value": {
                          "mode": "thresholds"
                        }
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "gauge",
                          "mode": "gradient",
                          "valueDisplayMode": "text"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
