    {
      "type": "timeseries",
      "title": "Serving CPU by Model",
      "description": "CPU cores used by each ModelDeployment's pods",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (label_serving_kamiwaza_ai_deployment_name) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\"}[5m]) * on (namespace, pod) group_left (label_serving_kamiwaza_ai_deployment_name) max by (namespace, pod, label_serving_kamiwaza_ai_deployment_name) (kube_pod_labels{namespace=\"$namespace\", label_serving_kamiwaza_ai_deployment_name!=\"\"}))",
          "legendFormat": "{{label_serving_kamiwaza_ai_deployment_name}}"
        }
