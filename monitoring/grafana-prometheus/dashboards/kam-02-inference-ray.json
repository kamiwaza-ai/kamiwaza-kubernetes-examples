        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kamiwaza_platform_component_state{namespace=\"$namespace\", component=\"modelServing\"} == 1",
          "legendFormat": "{{state}}",
          "instant": true
