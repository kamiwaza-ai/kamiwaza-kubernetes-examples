{
  "uid": "kam-08",
  "title": "Unified Log Explorer",
  "tags": ["kamiwaza"],
  "schemaVersion": 38,
  "version": 2,
  "editable": false,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "graphTooltip": 1,
  "links": [
    {
      "title": "Platform Overview",
      "url": "/d/kam-01",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Inference & Compute",
      "url": "/d/kam-02",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Application API",
      "url": "/d/kam-03",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Data Infrastructure",
      "url": "/d/kam-04",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Extensions & Operator",
      "url": "/d/kam-05",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Auth",
      "url": "/d/kam-06",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "K8s Events",
      "url": "/d/kam-07",
      "type": "link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Prometheus",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "loki_datasource",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "label": "Loki",
        "multi": false,
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Platform namespace",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kamiwaza_platform_condition, namespace)",
        "query": {
          "query": "label_values(kamiwaza_platform_condition, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "current": {},
        "multi": false,
        "includeAll": false,
        "sort": 1
      },
      {
        "name": "app",
        "type": "query",
        "label": "Workload",
        "hide": 0,
        "datasource": {
          "type": "loki",
          "uid": "${loki_datasource}"
        },
        "definition": "label_values({namespace=\"$namespace\"}, app)",
        "query": {
          "label": "app",
          "stream": "{namespace=\"$namespace\"}",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "sort": 1
      },
      {
        "name": "level",
        "type": "custom",
        "label": "Min Level",
        "hide": 0,
        "current": {
          "text": "error",
          "value": "(?i)(error|critical|fatal|panic)"
        },
        "options": [
          {
            "text": "all",
            "value": ".*"
          },
          {
            "text": "warning",
            "value": "(?i)(warn|error|critical|fatal|panic)"
          },
          {
            "text": "error",
            "value": "(?i)(error|critical|fatal|panic)"
          }
        ],
        "query": "all : .*, warning : (?i)(warn|error|critical|fatal|panic), error : (?i)(error|critical|fatal|panic)",
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Log Volume Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Log Rate by Workload (lines/sec)",
      "description": "Log lines per second by app.kubernetes.io/name",
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "expr": "sum by (app) (rate({namespace=\"$namespace\", app=~\"$app\"}[5m]))",
          "legendFormat": "{{app}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "drawStyle": "line"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Error Log Rate by Workload",
      "description": "Error lines per second by app.kubernetes.io/name",
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "expr": "sum by (app) (rate({namespace=\"$namespace\", app=~\"$app\"} |~ \"(?i)(error|fatal|critical)\" [5m]))",
          "legendFormat": "{{app}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "drawStyle": "line"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Filtered Log Stream",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Log Stream (workload=${app}, level=${level})",
      "description": "Every container log line for the selected workloads at or above the selected level",
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "expr": "{namespace=\"$namespace\", app=~\"$app\"} |~ \"${level}\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "maxDataPoints": 100,
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 12
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Pre-Built Diagnostic Queries",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "All Errors — Platform Namespace",
      "description": "Error-level lines across the platform namespace",
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "expr": "{namespace=\"$namespace\"} |~ \"(?i)(error|fatal|critical|panic|exception|traceback)\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "maxDataPoints": 100,
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Auth Failures (401 / 403 / unauthorized)",
      "description": "Authentication and authorization failures",
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "expr": "{namespace=\"$namespace\"} |~ \"(?i)( 401 | 403 |status[=: \\\"]*40[13]|unauthorized|forbidden|invalid.token|authentication.failed)\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "maxDataPoints": 100,
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "etcd Leader Changes & Elections",
      "description": "Coordination store elections",
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "expr": "{namespace=\"$namespace\", container=\"etcd\"} |~ \"(?i)(became.leader|leader|election|campaign|raft)\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "maxDataPoints": 100,
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 6
      }
    },
    {
      "type": "logs",
      "title": "Delegated Compute Crashes & Fatal Errors",
      "description": "Head and worker crash lines",
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "expr": "{namespace=\"$namespace\", app=\"core-raycluster\"} |~ \"(?i)(fatal|crash|traceback|oom|out of memory|worker died|worker failed)\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "maxDataPoints": 100,
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 6
      }
    },
    {
      "type": "logs",
      "title": "OOMKill Events (Kubernetes Events)",
      "description": "OOMKilled containers in the platform namespace",
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "expr": "{job=\"integrations/kubernetes/eventhandler\", namespace=\"$namespace\"} |= \"OOMKill\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "maxDataPoints": 100,
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 6
      }
    },
    {
      "type": "logs",
      "title": "Platform Operator Errors",
      "description": "Manager error lines",
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "expr": "{app=\"kamiwaza-platform-operator\"} |~ \"(?i)(\\\"level\\\":\\\"error\\\"|error)\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "maxDataPoints": 100,
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 6
      }
    }
  ]
}
