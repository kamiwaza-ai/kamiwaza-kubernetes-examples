{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kam-08"
  },
  "spec": {
    "title": "Kamiwaza · Log Explorer",
    "description": "What are the workloads saying?",
    "tags": ["kamiwaza"],
    "editable": false,
    "cursorSync": "Crosshair",
    "liveNow": false,
    "preload": false,
    "links": [
      {
        "title": "Kamiwaza dashboards",
        "type": "dashboards",
        "icon": "external link",
        "tooltip": "",
        "tags": ["kamiwaza"],
        "asDropdown": true,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      }
    ],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-3h",
      "to": "now",
      "autoRefresh": "1m",
      "autoRefreshIntervals": ["30s", "1m", "5m", "15m"],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Metrics",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "loki_datasource",
          "pluginId": "loki",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Logs",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "namespace",
          "label": "Namespace",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "current": {
            "text": "kamiwaza",
            "value": "kamiwaza"
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": false,
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(namespace)",
          "query": {
            "kind": "DataQuery",
            "group": "loki",
            "version": "v0",
            "datasource": {
              "name": "${loki_datasource}"
            },
            "spec": {
              "label": "namespace",
              "type": 1,
              "refId": "LokiVariableQueryEditor-VariableQuery"
            }
          }
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "app",
          "label": "Workload",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "options": [],
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "allowCustomValue": false,
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values({namespace=\"$namespace\"}, app)",
          "query": {
            "kind": "DataQuery",
            "group": "loki",
            "version": "v0",
            "datasource": {
              "name": "${loki_datasource}"
            },
            "spec": {
              "label": "app",
              "stream": "{namespace=\"$namespace\"}",
              "type": 1,
              "refId": "LokiVariableQueryEditor-VariableQuery"
            }
          }
        }
      },
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "level",
          "label": "Minimum level",
          "hide": "dontHide",
          "skipUrlSync": false,
          "multi": false,
          "includeAll": false,
          "allowCustomValue": false,
          "query": "all : .*, warning : (?i)(warn|error|critical|fatal|panic), error : (?i)(error|critical|fatal|panic)",
          "current": {
            "text": "warning",
            "value": "(?i)(warn|error|critical|fatal|panic)"
          },
          "options": [
            {
              "selected": false,
              "text": "all",
              "value": ".*"
            },
            {
              "selected": true,
              "text": "warning",
              "value": "(?i)(warn|error|critical|fatal|panic)"
            },
            {
              "selected": false,
              "text": "error",
              "value": "(?i)(error|critical|fatal|panic)"
            }
          ]
        }
      }
    ],
    "elements": {
      "volume": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Log volume",
          "description": "Lines per second by workload",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "sum by (app) (rate({namespace=\"$namespace\", app=~\"$app\"} | label_format app=\"{{ or .app .container .job }}\" [$__auto]))",
                        "legendFormat": "{{app}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc",
                  "hideZeros": false
                },
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": ["sum"],
                  "limit": 8,
                  "sortBy": "Total",
                  "sortDesc": true
                }
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "lineInterpolation": "smooth",
                    "lineWidth": 2,
                    "fillOpacity": 60,
                    "gradientMode": "opacity",
                    "showPoints": "never",
                    "spanNulls": true,
                    "axisSoftMin": 0,
                    "axisBorderShow": false,
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "errors": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Error lines",
          "description": "Error-level lines per second by workload",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "sum by (app) (rate({namespace=\"$namespace\", app=~\"$app\"} |~ \"(?i)(error|fatal|critical)\" | label_format app=\"{{ or .app .container .job }}\" [$__auto]))",
                        "legendFormat": "{{app}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc",
                  "hideZeros": false
                },
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": ["sum"],
                  "limit": 8,
                  "sortBy": "Total",
                  "sortDesc": true
                }
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "lineInterpolation": "smooth",
                    "lineWidth": 2,
                    "fillOpacity": 60,
                    "gradientMode": "opacity",
                    "showPoints": "never",
                    "spanNulls": true,
                    "axisSoftMin": 0,
                    "axisBorderShow": false,
                    "stacking": {
                      "mode": "normal",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "stream": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Log stream",
          "description": "Lines from the selected workloads at or above the selected level",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{namespace=\"$namespace\", app=~\"$app\"} |~ \"${level}\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": true,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "sortOrder": "Descending",
                "dedupStrategy": "none",
                "syntaxHighlighting": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "all-errors": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "All errors",
          "description": "Error-level lines across the namespace",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{namespace=\"$namespace\"} |~ \"(?i)(error|fatal|critical|panic|exception|traceback)\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": true,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "sortOrder": "Descending",
                "dedupStrategy": "none",
                "syntaxHighlighting": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "auth-failures": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Authentication failures",
          "description": "401, 403, and unauthorized lines",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{namespace=\"$namespace\"} |~ \"(?i)( 401 | 403 |status[=: \\\"]*40[13]|unauthorized|forbidden|authentication.failed|invalid.token)\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": true,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "sortOrder": "Descending",
                "dedupStrategy": "none",
                "syntaxHighlighting": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "elections": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Coordination store elections",
          "description": "etcd leader election lines",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{namespace=\"$namespace\", container=\"etcd\"} |~ \"(?i)(became.leader|election|campaign)\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": true,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "sortOrder": "Descending",
                "dedupStrategy": "none",
                "syntaxHighlighting": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "crashes": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Delegated compute crashes",
          "description": "Ray head and worker crash lines",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{namespace=\"$namespace\", app=\"core-raycluster\"} |~ \"(?i)(fatal|crash|traceback|oom|out of memory|worker died|worker failed)\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": true,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "sortOrder": "Descending",
                "dedupStrategy": "none",
                "syntaxHighlighting": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "oom": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "OOMKill events",
          "description": "Out-of-memory kills",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{job=\"integrations/kubernetes/eventhandler\", namespace=\"$namespace\"} |= \"OOMKill\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": true,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "sortOrder": "Descending",
                "dedupStrategy": "none",
                "syntaxHighlighting": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "operator": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Platform operator errors",
          "description": "Manager error lines",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{app=\"kamiwaza-platform-operator\"} |= \"\\\"level\\\":\\\"error\\\"\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": true,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "sortOrder": "Descending",
                "dedupStrategy": "none",
                "syntaxHighlighting": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "about": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "About this dashboard",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "**What are the workloads saying?**\n\nPick a namespace, one or more workloads (`app.kubernetes.io/name`), and a minimum level. The namespace selector lists every namespace Alloy collects from, not only the platform's. **Diagnostics** holds ready-made queries for the platform namespace; an empty panel means nothing matched.",
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "TabsLayout",
      "spec": {
        "tabs": [
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "title": "Explore",
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "title": "Volume",
                        "collapse": false,
                        "hideHeader": true,
                        "fillScreen": false,
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "maxColumnCount": 2,
                            "columnWidthMode": "standard",
                            "rowHeightMode": "standard",
                            "fillScreen": false,
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "volume"
                                  }
                                }
                              },
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "errors"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "title": "Stream",
                        "collapse": false,
                        "hideHeader": true,
                        "fillScreen": false,
                        "layout": {
                          "kind": "GridLayout",
                          "spec": {
                            "items": [
                              {
                                "kind": "GridLayoutItem",
                                "spec": {
                                  "x": 0,
                                  "y": 0,
                                  "width": 24,
                                  "height": 20,
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "stream"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "title": "Diagnostics",
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 2,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "tall",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "all-errors"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "auth-failures"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "elections"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "crashes"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
