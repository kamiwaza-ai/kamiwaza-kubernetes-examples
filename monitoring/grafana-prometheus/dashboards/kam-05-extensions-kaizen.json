      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(kamiwaza_sandbox_pool_ready_replicas{namespace=\"$namespace\"}) or vector(0)",
          "legendFormat": "",
