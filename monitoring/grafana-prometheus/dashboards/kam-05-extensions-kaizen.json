      "title": "Leader Elected",
      "description": "A manager replica holds the leader lease (requires operator metrics)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(leader_election_master_status{name=~\"kamiwaza-platform-operator.*\"}) or vector(0)",
          "legendFormat": "",
          "instant": true
