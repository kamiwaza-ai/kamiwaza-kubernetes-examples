    {
      "type": "stat",
      "title": "Extension Restarts (1h)",
      "description": "Container restarts in extension pods over the last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h]) * on (namespace, pod) group_left () max by (namespace, pod) (kube_pod_labels{namespace=\"$namespace\", label_kamiwaza_ai_extension!=\"\"}))) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "table",
      "title": "Extension Conditions",
      "description": "Every condition the operator reports on each Extension",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kamiwaza_extension_condition{namespace=\"$namespace\"}",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["name", "type", "Value", "reason"]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "name": 0,
              "type": 1,
              "Value": 2,
              "reason": 3
            },
            "renameByName": {
              "name": "Extension",
              "type": "Condition",
              "Value": "Status",
              "reason": "Reason"
            }
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Extension",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "False"
                      },
                      "1": {
                        "text": "True"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Extension CPU",
      "description": "CPU cores used by each extension's pods",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (label_kamiwaza_ai_extension) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\"}[5m]) * on (namespace, pod) group_left (label_kamiwaza_ai_extension) max by (namespace, pod, label_kamiwaza_ai_extension) (kube_pod_labels{namespace=\"$namespace\", label_kamiwaza_ai_extension!=\"\"}))",
          "legendFormat": "{{label_kamiwaza_ai_extension}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "drawStyle": "line"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Extension Memory",
      "description": "Working-set memory of each extension's pods",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (label_kamiwaza_ai_extension) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\"} * on (namespace, pod) group_left (label_kamiwaza_ai_extension) max by (namespace, pod, label_kamiwaza_ai_extension) (kube_pod_labels{namespace=\"$namespace\", label_kamiwaza_ai_extension!=\"\"}))",
          "legendFormat": "{{label_kamiwaza_ai_extension}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
