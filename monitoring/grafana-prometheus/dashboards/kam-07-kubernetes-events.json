{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kam-07"
  },
  "spec": {
    "title": "Kamiwaza · Kubernetes Events & Stability",
    "description": "Pod health, throttling, node pressure, and Kubernetes events in the platform namespace.",
    "tags": ["kamiwaza"],
    "editable": false,
    "cursorSync": "Crosshair",
    "liveNow": false,
    "preload": false,
    "links": [
      {
        "title": "Kamiwaza dashboards",
        "type": "dashboards",
        "icon": "external link",
        "tooltip": "",
        "tags": ["kamiwaza"],
        "asDropdown": true,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      }
    ],
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-3h",
      "to": "now",
      "autoRefresh": "30s",
      "autoRefreshIntervals": ["10s", "30s", "1m", "5m", "15m", "1h"],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Metrics",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "loki_datasource",
          "pluginId": "loki",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Logs",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "namespace",
          "label": "Platform namespace",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": false,
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(kamiwaza_platform_condition, namespace)",
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${datasource}"
            },
            "spec": {
              "query": "label_values(kamiwaza_platform_condition, namespace)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          }
        }
      }
    ],
    "elements": {
      "restarts": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Restarts (1h)",
          "description": "Container restarts over the last hour",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "round(sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h]))) or vector(0)",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": ["lastNotNull"],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false,
                "percentChangeColorMode": "inverted"
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "orange"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "oom": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "OOMKilled",
          "description": "Containers whose last termination was OOMKilled",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "count(kube_pod_container_status_last_terminated_reason{namespace=\"$namespace\", reason=\"OOMKilled\"}) or vector(0)",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": ["lastNotNull"],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false,
                "percentChangeColorMode": "inverted"
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "crashloop": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "CrashLoopBackOff",
          "description": "Containers waiting in CrashLoopBackOff",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "count(kube_pod_container_status_waiting_reason{namespace=\"$namespace\", reason=\"CrashLoopBackOff\"}) or vector(0)",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": ["lastNotNull"],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false,
                "percentChangeColorMode": "inverted"
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "pending": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Pending",
          "description": "Pods in Pending phase",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "count(kube_pod_status_phase{namespace=\"$namespace\", phase=\"Pending\"} == 1) or vector(0)",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": ["lastNotNull"],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false,
                "percentChangeColorMode": "inverted"
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "orange"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "image-pull": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Image pull failures",
          "description": "Containers that cannot pull their image",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "count(kube_pod_container_status_waiting_reason{namespace=\"$namespace\", reason=~\"ImagePullBackOff|ErrImagePull\"}) or vector(0)",
                        "legendFormat": "",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": ["lastNotNull"],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "wideLayout": true,
                "showPercentChange": false,
                "percentChangeColorMode": "inverted"
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "restart-rate": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Restarts (30m window)",
          "description": "Restarts per container, top 10",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "topk(10, round(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[30m])) > 0)",
                        "legendFormat": "{{pod}} · {{container}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc",
                  "hideZeros": false
                },
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": ["lastNotNull", "max"],
                  "limit": 10,
                  "sortBy": "Last *",
                  "sortDesc": true
                }
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "smooth",
                    "lineWidth": 2,
                    "fillOpacity": 18,
                    "gradientMode": "opacity",
                    "showPoints": "never",
                    "spanNulls": true,
                    "barAlignment": 0,
                    "axisBorderShow": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "throttling": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "CPU throttling, top 10",
          "description": "Share of CFS periods throttled",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "topk(10, 100 * rate(container_cpu_cfs_throttled_periods_total{namespace=\"$namespace\", container!=\"\"}[$__rate_interval]) / rate(container_cpu_cfs_periods_total{namespace=\"$namespace\", container!=\"\"}[$__rate_interval]))",
                        "legendFormat": "{{pod}} · {{container}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc",
                  "hideZeros": false
                },
                "legend": {
                  "showLegend": true,
                  "displayMode": "table",
                  "placement": "right",
                  "calcs": ["lastNotNull"],
                  "limit": 10,
                  "sortBy": "Last *",
                  "sortDesc": true
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 25,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "smooth",
                    "lineWidth": 2,
                    "fillOpacity": 18,
                    "gradientMode": "opacity",
                    "showPoints": "never",
                    "spanNulls": true,
                    "barAlignment": 0,
                    "axisBorderShow": false,
                    "axisSoftMin": 0,
                    "stacking": {
                      "mode": "none",
                      "group": "A"
                    },
                    "thresholdsStyle": {
                      "mode": "dashed"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "node-pressure": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Node pressure",
          "description": "Memory, disk, and PID pressure per node",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "max by (node, condition) (kube_node_status_condition{condition=~\"MemoryPressure|DiskPressure|PIDPressure\", status=\"true\"})",
                        "legendFormat": "{{node}} · {{condition}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "state-timeline",
            "version": "",
            "spec": {
              "options": {
                "showValue": "never",
                "rowHeight": 0.8,
                "mergeValues": true,
                "alignValue": "left",
                "tooltip": {
                  "mode": "single",
                  "sort": "none"
                },
                "legend": {
                  "showLegend": true,
                  "displayMode": "list",
                  "placement": "bottom",
                  "calcs": []
                }
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "OK",
                          "color": "green",
                          "index": 0
                        },
                        "1": {
                          "text": "Pressure",
                          "color": "red",
                          "index": 1
                        }
                      }
                    }
                  ],
                  "custom": {
                    "lineWidth": 0,
                    "fillOpacity": 85
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "warnings": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Warning events",
          "description": "Warning events for objects in the platform namespace",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{job=\"integrations/kubernetes/eventhandler\", namespace=\"$namespace\"} |= \"type=Warning\" |~ \"BackOff|OOMKill|Failed|Evict|Unhealthy|ImagePull|FailedScheduling\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": false,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "sortOrder": "Descending",
                "dedupStrategy": "exact",
                "syntaxHighlighting": true,
                "fontSize": "default",
                "detailsMode": "sidebar"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "operator-events": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Operator events",
          "description": "Events the platform operator records on platform resources",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${loki_datasource}"
                      },
                      "spec": {
                        "expr": "{job=\"integrations/kubernetes/eventhandler\", namespace=\"$namespace\"} |~ \"kind=(KamiwazaPlatform|ModelDeployment|Extension|SandboxPool)\"",
                        "legendFormat": ""
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": false,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "sortOrder": "Descending",
                "dedupStrategy": "exact",
                "syntaxHighlighting": true,
                "fontSize": "default",
                "detailsMode": "sidebar"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "TabsLayout",
      "spec": {
        "tabs": [
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "title": "Stability",
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "title": "Summary",
                        "collapse": false,
                        "hideHeader": true,
                        "fillScreen": false,
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "maxColumnCount": 5,
                            "columnWidthMode": "narrow",
                            "rowHeightMode": "short",
                            "fillScreen": false,
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "restarts"
                                  }
                                }
                              },
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "oom"
                                  }
                                }
                              },
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "crashloop"
                                  }
                                }
                              },
