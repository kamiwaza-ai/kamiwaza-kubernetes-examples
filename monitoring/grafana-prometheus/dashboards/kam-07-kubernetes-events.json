{
  "uid": "kam-07",
  "title": "Kubernetes Events & Stability",
  "tags": ["kamiwaza"],
  "schemaVersion": 38,
  "version": 2,
  "editable": false,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "graphTooltip": 1,
  "links": [
    {
      "title": "Platform Overview",
      "url": "/d/kam-01",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Inference & Compute",
      "url": "/d/kam-02",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Application API",
      "url": "/d/kam-03",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Data Infrastructure",
      "url": "/d/kam-04",
