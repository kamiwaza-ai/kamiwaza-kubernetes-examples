    {
      "id": 5,
      "type": "timeseries",
      "title": "etcd Proposals Committed vs Failed /s",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(etcd_server_proposals_committed_total{job=\"core-etcd\"}[5m])",
          "legendFormat": "Committed/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(etcd_server_proposals_failed_total{job=\"core-etcd\"}[5m])",
          "legendFormat": "Failed/s (should be 0)"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "drawStyle": "line"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed/s (should be 0)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "etcd WAL Fsync Duration (p99)",
      "description": "p99 WAL sync latency \u2014 high values signal disk I/O pressure",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, rate(etcd_disk_wal_fsync_duration_seconds_bucket{job=\"core-etcd\"}[5m]))",
          "legendFormat": "p99 WAL fsync"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "drawStyle": "line",
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "rgba(255, 152, 48, 0.1)",
                "value": 0.01
              },
              {
                "color": "rgba(242, 73, 92, 0.15)",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      }
    },
