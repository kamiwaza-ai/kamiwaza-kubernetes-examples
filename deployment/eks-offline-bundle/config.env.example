# ═══════════════════════════════════════════════════════════════════════════════
#  Kamiwaza  offline → EKS  —  OPERATIONAL config.   Copy to config.env and edit.
#     cp config.env.example config.env   &&   $EDITOR config.env
#  config.env is git-ignored — it holds your account id, paths, and admin password.
#  Platform config (domain + image tags) lives in  overrides.yaml.
#
#  Then:  make relocate   (one time — push images + charts into ECR)
#         make deploy
#
#  The values below are EXAMPLES — replace them with your own.
# ═══════════════════════════════════════════════════════════════════════════════

# ── AWS / cluster ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT=111122223333                      # your 12-digit AWS account id
CLUSTER_NAME=kamiwaza-eks                      # the target EKS cluster name
KUBECONFIG=~/.kube/kamiwaza-eks.yaml          # a kubeconfig pointed at that cluster
                                              #   aws eks update-kubeconfig --name $CLUSTER_NAME \
                                              #     --region $AWS_REGION --kubeconfig $KUBECONFIG

# ── extracted bundle locations ─────────────────────────────────────────────────
#   Extract the release bundle, e.g. into /data/kamiwaza-bundle:
#     rpm2cpio kamiwaza-prod-*.rpm | (cd /data/kamiwaza-bundle && cpio -idm)   # -> opt/kamiwaza
#     tar -xf kamiwaza-helm.*.tar -C /data/kamiwaza-bundle/wrap                # -> wrap/kamiwaza-helm
WORK=/data/kamiwaza-bundle/opt/kamiwaza        # the prod RPM extracted here
WRAP_DIR=/data/kamiwaza-bundle/wrap/kamiwaza-helm   # the extracted *.wrap files
#   (the embedding model is auto-detected from $WORK/prereqs/models/*.gguf)

# ── platform ───────────────────────────────────────────────────────────────────
DOMAIN=kamiwaza.test                          # hostname the UI / API are served on
ADMIN_PASSWORD=change-me                       # seeded as the kamiwaza-user-admin secret — set your own

# ── release version ─────────────────────────────────────────────────────────────
#   Tag for all Kamiwaza-built images (core, frontend, datahub-*, …). One knob
#   re-targets them all. Set this to your bundle's release.
KAMIWAZA_VERSION=release-0.13.3

# ── third-party image tags ───────────────────────────────────────────────────────
#   Independent of the Kamiwaza version. The values below are the pins shipped with
#   the v0.13.3 bundle; for a different bundle refresh them with `make show-tags`.
KEYCLOAK_TAG=v26.6.2
POSTGRES_TAG=v18.4
ETCD_TAG=v3.6.10
KUBECTL_TAG=v1.35.5-dev
CURL_TAG=v8.19.0-dev
LLAMACPP_TAG=linux-amd64-d20260608
TRAEFIK_TAG=v3.6.9-kz.1
KAFKA_TAG=v4.3.0
NEO4J_TAG=v5.26.25-kz.1
OPENSEARCH_TAG=v3.5.0

# ── derived (rarely change) ────────────────────────────────────────────────────
REGISTRY=$AWS_ACCOUNT.dkr.ecr.$AWS_REGION.amazonaws.com
BUNDLE_REGISTRY_PLACEHOLDER=host.docker.internal:5001
