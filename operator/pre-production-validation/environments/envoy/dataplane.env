# Where this implementation runs the proxy that serves the published Gateway,
# and therefore where platform callbacks travel.
#
# This is environment-owned infrastructure knowledge, stated once per
# environment rather than derived in a shared script. Deriving it meant
# matching per-implementation ownership labels, which is agnostic only against
# the implementations someone already listed: this one labels its Service per
# Gateway, the second labels it differently, and the third shares one proxy
# Service across every Gateway with no ownership label at all. In a real
# installation the same fact is an administrator statement in immutable
# policy, so stating it here is the same act.
#
# This implementation names the Service after the Gateway it serves and
# suffixes a hash, so the name is read from the cluster rather than written
# here. The namespace is fixed by where the controller was installed.
CALLBACK_SERVICE_NAMESPACE=envoy-gateway-system
CALLBACK_SERVICE_SELECTOR=gateway.envoyproxy.io/owning-gateway-name=kamiwaza-gateway

# Both Extended features the platform emits objects for are documented and
# conformance-reported for this implementation.
ATTESTED_GATEWAY_FEATURES=[BackendTLSPolicy,HTTPRouteSchemeRedirect]
