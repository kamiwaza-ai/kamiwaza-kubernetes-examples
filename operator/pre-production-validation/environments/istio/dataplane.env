# Where this implementation runs the proxy that serves the published Gateway.
# See envoy/dataplane.env for why this is stated per environment.
#
# This implementation provisions the data plane in the Gateway's own namespace
# and labels it with the Gateway name.
CALLBACK_SERVICE_NAMESPACE=kamiwaza-examples-secondary
CALLBACK_SERVICE_SELECTOR=istio.io/gateway-name=kamiwaza-gateway

# Both Extended features the platform emits objects for are documented and
# conformance-reported for this implementation.
ATTESTED_GATEWAY_FEATURES=[BackendTLSPolicy,HTTPRouteSchemeRedirect]
