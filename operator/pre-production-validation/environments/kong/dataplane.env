# Where this implementation runs the proxy that serves the published Gateway.
# See envoy/dataplane.env for why this is stated per environment.
#
# This implementation runs one shared proxy for every Gateway and stamps no
# per-Gateway ownership label, which is exactly why the address is a statement
# here instead of a label query. The name is the chart's, so it is written
# rather than discovered.
CALLBACK_SERVICE_NAMESPACE=kong
CALLBACK_SERVICE_NAME=kong-gateway-proxy

# Only one of the two. This implementation documents BackendTLSPolicy from
# its 3.4 release behind the feature gate the installer enables, so the
# attestation is honest and the platform proves it from the published object's
# own status. Scheme redirect is deliberately not attested: this
# implementation reports it unsupported upstream and offers the behavior
# through its own annotation instead, which the platform will not write. The
# platform must then withhold that one feature and report the gap -- which is
# the case this environment exists to exercise.
ATTESTED_GATEWAY_FEATURES=[BackendTLSPolicy]
